# Copy to .env.local and paste your key from https://console.typesafe.ai/keys
# The key is read only by the server (app/api/decide/route.ts). It is never sent to the browser.
TYPESAFE_API_KEY=

# Optional: pin a model version for repeatable runs (default: jev-latest).
TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional: an answer slower than this many milliseconds is a timeout (default: 2000).
JEV_TIMEOUT_MS=2000

# Optional: reply without calling TypeSafe, picking the first legal direction.
# Lets the whole app (controller, telemetry, UI) run with no API key.
JEV_MOCK=false
